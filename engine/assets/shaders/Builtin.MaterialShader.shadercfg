# NK shader configuration
version=1
name=Builtin.MaterialShader
render_pass=world
max_instances=1024
wireframe=false
depth_test=true

stage=vertex,vertex,main
stage=fragment,fragment,main

attribute=f32_3,position
attribute=f32_3,normal
attribute=f32_2,texcoord
attribute=f32_4,tangent

uniform=mat4,global,projection
uniform=mat4,global,view
uniform=f32_4,instance,diffuse_color
uniform=sampler_2d,instance,diffuse_texture
uniform=mat4,local,model
uniform=f32_4,global,ambient_color
uniform=f32_3,global,directional_light_direction
uniform=f32_4,global,directional_light_color
uniform=mat4,local,normal_matrix
uniform=sampler_2d,instance,specular_texture
uniform=f32,instance,shininess
uniform=f32_3,global,view_position
uniform=sampler_2d,instance,normal_texture
uniform=u32,global,point_light_count
uniform=custom,global,point_lights,2,48

# NK skybox shader configuration
version=1
name=Builtin.SkyboxShader
render_pass=world
max_instances=8
wireframe=false
depth_test=true
depth_write=false
depth_compare=less_equal
cull_mode=front

stage=vertex,vertex,main
stage=fragment,fragment,main

attribute=f32_3,position
attribute=f32_3,normal
attribute=f32_2,texcoord
attribute=f32_4,tangent

uniform=mat4,global,projection
uniform=mat4,global,view
uniform=sampler_cube,instance,cube_texture
uniform=mat4,local,model
